{:paths ["scripts"]
 :tasks {build    {:doc  "Build the pod binary (target/release/pod-kpassapk-emacs)."
                   :task (shell "cargo build --release")}
         test     {:doc      "Run the pod test suite (builds the pod, loads it, runs clojure.test)."
                   :depends  [build]
                   :requires ([babashka.fs :as fs])
                   ;; A fresh user dir per run: the suite installs packages,
                   ;; and they must neither land in <cache>/emacs.d nor be
                   ;; there already the next time.
                   :task     (let [dir (fs/create-temp-dir {:prefix "pod-kpassapk-emacs-test"})]
                               (try
                                 (shell {:extra-env {"POD_KPASSAPK_EMACS_USER_DIR" (str dir)}}
                                        "bb scripts/run-tests.clj")
                                 (finally (fs/delete-tree dir))))}
         release  {:doc      "Cut and publish a release: bb release <version> [--dry-run]. See doc/release.md."
                   :requires ([release])
                   :task     (apply release/main *command-line-args*)}
         registry-pr {:doc   "Open the pod-registry PR for a published release: bb registry-pr [version] [--dry-run]."
                      :requires ([release])
                      :task  (apply release/registry-pr-main *command-line-args*)}
         manifest {:doc      "Print the pod-registry manifest.edn for the version in Cargo.toml."
                   :requires ([release])
                   :task     (release/print-manifest)}
         vendor   {:doc      "Update vendored elisp libs to upstream HEAD: bb vendor [lib ...]."
                   :requires ([vendor])
                   :task     (apply vendor/main *command-line-args*)}}}
